# Mainland build defaults only. Copy to .env.mainland; do not commit secrets.
VITE_DEPLOYMENT_REGION=cn
VITE_DEFAULT_LOCALE=zh-CN
VITE_DEFAULT_PHONE_REGION=CN

# Configure only after selecting an approved mainland-hosted backend and reviewing its filing/data location.
# VITE_SUPABASE_URL=https://your-mainland-auth-endpoint.example
# VITE_SUPABASE_ANON_KEY=public-browser-key-only
# Backend API (no secret belongs in VITE_* values).
# For a same-origin production gateway, use VITE_API_BASE_URL=/api.
# For local development, point Vite's proxy at your running API: see API_PROXY_TARGET below.
# VITE_API_BASE_URL=/api
# API_PROXY_TARGET=http://127.0.0.1:3000
# Or set a public API origin, and configure CORS on that API: VITE_API_BASE_URL=https://api.example.com
