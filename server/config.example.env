# Copy to server/.env on the server. Never commit that file.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://your-mainland-domain.example

# Private PostgreSQL connection string; never use a VITE_ variable for this.
DATABASE_URL=postgresql://app_user:replace-me@db.internal:5432/huanhuan
DATABASE_SSL=require

# Public JWKS URL and exact issuer/audience for the selected identity provider.
AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
AUTH_ISSUER=https://identity.example/
AUTH_AUDIENCE=huanhuan-api
